{
    "providers": [
        {
            "name": "openai-gpt4",
            "type": "openai",
            "endpoint": "https://api.openai.com/v1",
            "api_key": "${OPENAI_API_KEY}",
            "model": "gpt-4",
            "parameters": {
                "temperature": 0.7,
                "max_tokens": 4096
            }
        },
        {
            "name": "ollama-local",
            "type": "ollama",
            "endpoint": "http://localhost:11434",
            "api_key": "",
            "model": "llama3",
            "parameters": {
                "temperature": 0.5,
                "num_predict": 2048
            }
        }
    ]
}
